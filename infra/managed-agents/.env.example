# ============================================================================
# Managed Agents Environment Configuration
# ============================================================================
# Copy this file to .env and update values for your environment

# ============================================================================
# API Server Configuration
# ============================================================================
API_PORT=8000
LOG_LEVEL=info
ENVIRONMENT=development

# ============================================================================
# Authentication (fail closed: services refuse to start if unset)
# ============================================================================
# Comma-separated API keys for the /v1 control-plane routes. Clients send one as
# `x-api-key: <key>` or `Authorization: Bearer <key>`. Generate: openssl rand -hex 32
MANAGED_AGENTS_API_KEYS=
# Set to 1 ONLY for local development to run the API without keys.
MANAGED_AGENTS_INSECURE_DEV=0

# Shared bearer token between the orchestrator (API) and every node agent (:9090).
NODE_AGENT_TOKEN=
# Set to 1 ONLY for local development to run the node agent without a token.
NODE_AGENT_INSECURE_DEV=0
# Node agent override policy
# Runtimes a session may request (default firecracker,gvisor; runc is weaker).
NODE_AGENT_ALLOWED_RUNTIMES=firecracker,gvisor
# Registry prefixes allowed for harness image overrides (empty = none allowed).
NODE_AGENT_ALLOWED_IMAGE_PREFIXES=
# Per-session resource ceilings enforced on resource_overrides / resource_request.
MAX_SESSION_VCPUS=16
MAX_SESSION_MEMORY_MB=65536
MAX_SESSION_DISK_MB=262144
MAX_SESSION_TIMEOUT_SECONDS=86400
# Harness rootfs overrides must resolve inside this directory.
ROOTFS_ROOT=/var/lib/managed-agents/rootfs

# ============================================================================
# PostgreSQL Configuration
# ============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=managed_agents
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/managed_agents

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ============================================================================
# LLM Backend Configuration
# ============================================================================
# Choose between: "anthropic" or "vllm"
LLM_DEFAULT_BACKEND=anthropic

# Anthropic API Configuration
ANTHROPIC_API_KEY=your-api-key-here
LLM_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# vLLM Configuration (if using vLLM backend)
LLM_VLLM_ENDPOINT=http://localhost:8001/v1
LLM_VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ============================================================================
# Session Management
# ============================================================================
SESSION_NAMESPACE=managed-agents-sessions
SESSION_MAX_CONCURRENT=50
SESSION_TTL_SECONDS=3600

# Runtime image
RUNTIME_IMAGE=managed-agents-runtime:latest
RUNTIME_CPU_REQUEST=1
RUNTIME_MEMORY_REQUEST=2Gi
RUNTIME_CPU_LIMIT=2
RUNTIME_MEMORY_LIMIT=4Gi

# ============================================================================
# Kubernetes Configuration (for Helm deployment)
# ============================================================================
# Namespace where managed-agents is deployed
K8S_NAMESPACE=default

# Service account name
K8S_SERVICE_ACCOUNT=managed-agents-api

# ============================================================================
# Monitoring and Observability
# ============================================================================
METRICS_ENABLED=false
TRACING_ENABLED=false
LOG_FORMAT=json

# ============================================================================
# Development Configuration
# ============================================================================
DEBUG=false
RELOAD=true  # Enable hot-reload for development
