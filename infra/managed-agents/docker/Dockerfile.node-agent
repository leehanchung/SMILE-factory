# Node agent: runs on worker nodes, manages bubblewrap-sandboxed sessions.
# Requires bubblewrap installed on the host or in the image.
# Runs as root on purpose: it manages sandboxes / microVMs (namespaces, /dev/kvm).
# Requires NODE_AGENT_TOKEN (bearer auth; refuses to start without it). Still never
# expose :9090 beyond the cluster network.

FROM python:3.13-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    bubblewrap \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml poetry.lock* ./

ARG POETRY_VERSION=2.4.0
RUN pip install --no-cache-dir "poetry==${POETRY_VERSION}" && \
    poetry config virtualenvs.create false && \
    poetry install --no-interaction --no-ansi --only main --no-root

COPY src/ ./src/

# ---

FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    bubblewrap \
    procps \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /app /app

WORKDIR /app

# Create directories for session data
RUN mkdir -p /var/lib/managed-agents/workspaces /var/lib/managed-agents/logs

EXPOSE 9090

CMD ["uvicorn", "src.orchestrator.node_agent:app", "--host", "0.0.0.0", "--port", "9090"]
